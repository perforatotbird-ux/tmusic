# ==============================================================================
# T-Music Standalone Web App Configuration
# ==============================================================================

PROJECT_NAME=T-Music
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8005

# Dedicated PostgreSQL Database (tgmusic)
DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5433/tgmusic

# High-Security Authentication
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME
# SESSION_SECRET keys the Fernet encryption of Telegram credentials stored in
# tg_accounts (session_string, api_hash). Generate the same way; keep it backed
# up — losing it makes stored TG sessions undecryptable.
SESSION_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
REQUIRE_AUTH=true
# Set true when the app is served over HTTPS (cookie Secure flag + HSTS header)
COOKIE_SECURE=false
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP
TRUST_PROXY_HEADERS=false
# JSON list — never use "*" with credentials
ALLOWED_ORIGINS=["http://localhost:8005","http://127.0.0.1:8005"]
# Host-header allowlist (Starlette TrustedHostMiddleware): requests with any
# other Host get a 400 before routing, which kills Host-poisoning of share
# URLs. "*" (default) disables the check; set hostnames once stable, e.g.
# TRUSTED_HOSTS=["tmusic.lan","192.168.1.50:8005"]
# TRUSTED_HOSTS=["*"]
# Allow CORS credentialed access from any private-range origin (LAN/mobile).
# Set false once every client has an explicit ALLOWED_ORIGINS entry.
# CORS_ALLOW_LAN=true

# Operational knobs (all optional — defaults shown)
# API_RATE_LIMIT_PER_MIN=120
# AUTH_RATE_LIMIT_PER_MIN=10
# TG_MAX_CONCURRENT_TRANSMISSIONS=3
# COVER_HTTP_TIMEOUT_SEC=20
# COVER_HTTP_CONNECT_TIMEOUT_SEC=8
# COVER_MAX_IMAGE_BYTES=10485760
LOG_ARCHIVE_PASSWORD=CHANGE_ME

# Admin panel bootstrap (one-shot): bcrypt hash applied to the admin account on
# startup — EITHER when the account is missing OR when this env value CHANGES
# (deliberate rotation). A password changed later in the panel SURVIVES restarts
# (the applied hash is remembered in app_settings). Generate with:
#   python scripts/init_admin.py --hash-only "your-password"
# Recommended hygiene: remove this variable after the first successful boot.
# ADMIN_PASSWORD_HASH=$2b$12$...

# Dedicated Telegram MTProto Streaming Session
TG_API_ID=123
TG_API_HASH=
TG_SESSION_STRING=
TG_SESSION_NAME=tmusic_session
TG_WORKERS=2
SLEEP_THRESHOLD=60

# Optional Metadata Enrichment Keys
# Last.fm — official names: api_key + shared secret. Both aliases accepted:
#   LASTFM_SHARED_SECRET=...  (preferred)  or  LASTFM_API_SECRET=...
# Scrobble/now-playing additionally require LASTFM_SESSION_KEY (user token).
# Generate token via Last.fm auth/getToken + auth/getSession (desktop flow).
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
# LASTFM_API_SECRET=
LASTFM_SESSION_KEY=
# LASTFM_USERNAME=
# LASTFM_ENABLED=true
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# ─── 2026-09 security audit additions ────────────────────────────────────────
# Default TTL (hours) for share links created without an explicit expiry.
# 0 = legacy "never expires". Explicit exp=0 via API still means permanent.
# SHARE_DEFAULT_TTL_HOURS=720
#
# Subsonic clients authenticate ONLY with the dedicated per-user token
# (p=<token> or t=md5(token+salt)); the panel password is no longer accepted
# in query strings. Tokens are minted/rotated in the web panel
# (GET/POST /api/subsonic/credentials*). No env configuration required.
